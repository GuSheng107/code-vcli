{
  "name": "vcli",
  "version": "1.0.0",
  "description": "vcli — VisionCLI 截图转文本工具",
  "type": "module",
  "bin": {
    "vcli": "dist/cli.js"
  },
  "files": [
    "dist",
    "resources/ocr/vcli_inference.py",
    "resources/ocr/requirements.txt",
    "README.md",
    "scripts/postinstall.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "vision",
    "ocr",
    "screenshot",
    "cli",
    "ai-agent",
    "ppocrv6",
    "omniparser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuSheng107/vcli.git"
  },
  "bugs": {
    "url": "https://github.com/GuSheng107/vcli/issues"
  },
  "homepage": "https://github.com/GuSheng107/vcli",
  "license": "AGPL-3.0-or-later",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.5",
    "typescript": "5.9.3"
  }
}
